// Sulfur++ OOP Demo

// ─── Struct ───────────────────────────────────────────────────────────────────
struct Vec2 {
    x: float_32,
    y: float_32
}

let origin = Vec2(0.0, 0.0);
let pos    = Vec2(3.0, 4.0);
Terminal.Out << ps"Position: ({pos.x}, {pos.y})";

// ─── Class ────────────────────────────────────────────────────────────────────
class Player {
    name: str;
    hp: int_32;
    maxHp: int_32;

    fn init(playerName: str, health: int_32) {
        self.name  = playerName;
        self.hp    = health;
        self.maxHp = health;
    }

    fn takeDamage(amount: int_32) {
        self.hp -= amount;
        if (self.hp < 0) { self.hp = 0; }
        Terminal.Out << ps"{self.name} took {amount} damage! HP: {self.hp}/{self.maxHp}";
    }

    fn heal(amount: int_32) {
        self.hp += amount;
        if (self.hp > self.maxHp) { self.hp = self.maxHp; }
        Terminal.Out << ps"{self.name} healed {amount} HP! HP: {self.hp}/{self.maxHp}";
    }

    fn isAlive(): bool {
        return self.hp > 0;
    }

    fn status() {
        let bar = ps"[{self.name}] HP: {self.hp}/{self.maxHp} | Alive: {self.isAlive()}";
        Terminal.Out << bar;
    }
}

var hero = Player("Aria", 100);
hero.status();
hero.takeDamage(30);
hero.heal(10);
hero.takeDamage(80);
hero.status();

// ─── Interface ────────────────────────────────────────────────────────────────
interface Drawable {
    fn draw();
}

class Circle {
    radius: float_32;

    fn init(r: float_32) {
        self.radius = r;
    }

    fn draw() {
        Terminal.Out << ps"Drawing circle with radius {self.radius}";
    }

    fn area(): float_64 {
        return PI * self.radius * self.radius;
    }
}

var c = Circle(5.0);
c.draw();
Terminal.Out << ps"Area: {c.area()}";
