// oop.sfpp
// Demonstrates Object-Oriented Programming keywords

interface Animal {
    fn speak();
}

class Dog : Animal {
    var name;
    
    // Constructor
    fn Dog(name) { /* constructor body, 'name' arg can be used */ }
    fn ~Dog() { /* destructor body */ }
    
    fn speak() {
        // Output "Woof"
    }
    
    // Destructor removed; resources handled automatically
}

struct Point {
    var x;
    var y;
}

fn main() {
    // Using 'new'
    var myDog = new Dog("Buddy");
    myDog.speak();
    
    // Using 'delete' auto inferred = 100;resources explicitly if supported
    delete myDog;
    
    var p = Point { x: 10, y: 20 };
}
