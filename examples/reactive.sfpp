// Sulfur++ Reactive System Demo

// ─── Reactive Variables ───────────────────────────────────────────────────────
reactive hp = 100;
reactive gold = 0;

// ─── Watch Blocks ─────────────────────────────────────────────────────────────
watch hp {
    Terminal.Out << ps"[WATCH] HP changed to: {hp}";
}

watch hp <= 0 {
    Terminal.Out << "☠ Player has died!";
}

watch gold {
    Terminal.Out << ps"[WATCH] Gold changed: {gold} gp";
}

// ─── Signal System ────────────────────────────────────────────────────────────
signal OnLevelUp;
signal OnDamage;

on OnLevelUp {
    Terminal.Out << "★ LEVEL UP! Stats increased!";
    hp = hp + 50;
}

on OnDamage {
    Terminal.Out << "⚡ Damage signal received!";
}

// ─── Trigger changes ──────────────────────────────────────────────────────────
Terminal.Out << "--- Starting simulation ---";

hp = 80;    // triggers watch hp
gold = 100; // triggers watch gold

emit OnDamage;   // triggers OnDamage handler
hp = hp - 90;    // triggers watch hp AND watch hp <= 0

gold = 250;
emit OnLevelUp;  // triggers OnLevelUp -> also changes hp
