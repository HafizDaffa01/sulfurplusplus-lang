import std/io as io;
import std/matrix as mat;

// Create matrices (List of Lists)
var A = [
    [1, 2],
    [3, 4]
];

var B = [
    [2, 0],
    [1, 2]
];

io.Terminal.Out << "Matrix A: " << A << io.Terminal.EOL;
io.Terminal.Out << "Matrix B: " << B << io.Terminal.EOL;

// Matrix Addition
io.Terminal.Out << "A + B = " << mat.m_Add(A, B) << io.Terminal.EOL;

// Matrix Multiplication (Dot Product)
io.Terminal.Out << "A * B = " << mat.m_Mul(A, B) << io.Terminal.EOL;

// Matrix Transpose
io.Terminal.Out << "Transpose(A) = " << mat.m_Transpose(A) << io.Terminal.EOL;

// Scalar Multiplication
io.Terminal.Out << "3 * A = " << mat.m_Scale(A, 3) << io.Terminal.EOL;

// Identity Matrix
io.Terminal.Out << "Eye(3) = " << mat.m_Eye(3) << io.Terminal.EOL;
