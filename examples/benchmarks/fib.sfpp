import std/io as io;
import std/time as time;

fn fib(n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

var start = time.micros();
var result = fib(32);
var end = time.micros();

io.Terminal.Out << "Fibonacci(32) = " << result << io.Terminal.EOL;
io.Terminal.Out << "Time taken: " << (end - start) / 1000000.0 << " seconds" << io.Terminal.EOL;
