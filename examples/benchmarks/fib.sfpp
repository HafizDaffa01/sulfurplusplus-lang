// Sulfur++ Benchmark
// Based on available std: io.sfpp and others.

import std/builtin --use=[NOLIBNAME];

fn fib(n) {
    var a = 0;
    var b = 1;
    var i = 0;
    while (i < n) {
        var temp = a;
        a = b;
        b = temp + b;
        i = i + 1;
    }
    return a;
}

var start = now();
var result = fib(50);
var end = now();

Terminal.Out << "Fibonacci(50) = " << result << Terminal.EOL;
Terminal.Out << "Time taken: " << (end - start) / 1000000.0 << " seconds" << Terminal.EOL;
