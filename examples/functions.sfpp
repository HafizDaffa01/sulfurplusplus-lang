// Sulfur++ Functions Demo

// ─── Basic Function ───────────────────────────────────────────────────────────
fn greet(name: str): str {
    return ps"Hello, {name}!";
}

Terminal.Out << greet("World");

// ─── Recursion ────────────────────────────────────────────────────────────────
fn factorial(n: int_32): int_32 {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

Terminal.Out << ps"10! = {factorial(10)}";

fn fibonacci(n: int_32): int_32 {
    if (n <= 1) { return n; }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

Terminal.Out << ps"fib(10) = {fibonacci(10)}";

// ─── Higher-Order Functions ───────────────────────────────────────────────────
fn apply(value: int_32, transform: fn): int_32 {
    return transform(value);
}

let tripled = apply(7, fn(x) { return x * 3; });
Terminal.Out << ps"apply(7, *3) = {tripled}";

// ─── Closures ─────────────────────────────────────────────────────────────────
fn makeCounter(): fn {
    var count = 0;
    return fn() {
        count += 1;
        return count;
    };
}

let counter = makeCounter();
Terminal.Out << ps"Counter: {counter()}"; // 1
Terminal.Out << ps"Counter: {counter()}"; // 2
Terminal.Out << ps"Counter: {counter()}"; // 3

// ─── Variadic-style with lists ────────────────────────────────────────────────
fn sumAll(nums: list<int_32>): int_32 {
    var total = 0;
    for (n in nums) {
        total += n;
    }
    return total;
}

let total = sumAll([10, 20, 30, 40, 50]);
Terminal.Out << ps"Sum of list: {total}";

// ─── Math with constants ──────────────────────────────────────────────────────
fn circleArea(r: float_64): float_64 {
    return PI * r * r;
}

Terminal.Out << ps"Circle area (r=5): {circleArea(5.0)}";
Terminal.Out << ps"sqrt(144) = {sqrt(144.0)}";
Terminal.Out << ps"pow(2, 10) = {pow(2.0, 10.0)}";
