// functions.sfpp
// Demonstrates function-related keywords

fn add(a, b) {
    return a + b;
}

fn greet(name) {
    import std/io --use=[NOLIBNAME];
    Terminal.Out << "Hello, " << name << Terminal.EOL;
}

// main entry removed; example focuses on functions only
    var result = add(5, 10);
    greet("Developer");
}
