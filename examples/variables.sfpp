// variables.sfpp
// Demonstrates all variable declaration and basic type keywords

// Mutable variables
var age = 25;
var name = "Sulfur";

// Immutable variables
let pi = 3.14159;

// Type inference and dynamic types
auto inferred = 100;
auto dynamicVar = "Can be a string"; // using auto for inferred type
dynamicVar = 42; // Now it's an integer

// Primitive Types explicitly typed
int_8 myByte = 127;
int_16 myShort = 32000;
int_32 myInt = 100000;
int_64 myLong = 9000000000;

uint_8 myUByte = 255;
uint_16 myUShort = 65000;
uint_32 myUInt = 4000000000;
uint_64 myULong = 18000000000000000000;

float_32 myFloat = 3.14f;
float_64 myDouble = 2.718281828;

bool isReady = true;
bool isFinished = false;

char letter = 'A';
str message = "Hello, World!";
void emptyFunc() { }
