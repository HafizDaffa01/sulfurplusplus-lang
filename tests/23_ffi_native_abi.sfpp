import std/io as io;
import std/ffi as ffi;

fn assert(cond, name) {
    if (!cond) {
        io.Terminal.Out << "FAIL: " << name << "\n";
        throw "Assertion failed: " + name;
    }
    io.Terminal.Out << "PASS: " << name << "\n";
}

// 1. C Type Sizes via FFI ABI Introspection
assert(ffi.sizeof("int64") == 8, "sizeof(int64) == 8 bytes");
assert(ffi.sizeof("int32") == 4, "sizeof(int32) == 4 bytes");
assert(ffi.sizeof("int16") == 2, "sizeof(int16) == 2 bytes");
assert(ffi.sizeof("int8") == 1, "sizeof(int8) == 1 byte");
assert(ffi.sizeof("float64") == 8, "sizeof(float64) == 8 bytes");
assert(ffi.sizeof("float32") == 4, "sizeof(float32) == 4 bytes");
assert(ffi.sizeof("ptr") == 8, "sizeof(ptr) == 8 bytes (64-bit ABI)");
assert(ffi.sizeof("bool") == 1, "sizeof(bool) == 1 byte");

// 2. Cross-platform Dynamic Library Loading and C ABI Function Invocation
// Supports Windows (kernel32.dll / msvcrt.dll), Linux (libc.so.6 / libc.so), and macOS (libSystem.B.dylib)
var libCandidates = ["kernel32.dll", "libc.so.6", "libc.so", "libSystem.B.dylib", "libm.so.6", "msvcrt.dll"];
var loadedLib = null;
var loadedName = "";

for (candidate in libCandidates) {
    if (loadedLib == null) {
        try {
            var lib = ffi.load(candidate);
            loadedLib = lib;
            loadedName = candidate;
        } catch (e) {
            // try next candidate
        }
    }
}

assert(loadedLib != null, "Cross-platform system native library loaded: " + loadedName);

// 3. Symbol resolution and invocation test
var symFound = false;
var funcNames = ["GetCurrentProcessId", "getpid", "abs", "time", "clock"];
for (fnName in funcNames) {
    if (!symFound) {
        try {
            var sym = loadedLib.sym(fnName);
            if (sym != null) {
                var res = ffi.callInt(sym, []);
                symFound = true;
                io.Terminal.Out << "PASS: Resolved and called native symbol: " << fnName << "\n";
            }
        } catch (e) {
            // try next symbol
        }
    }
}

assert(symFound, "Successfully resolved and executed native ABI function");
loadedLib.close();

io.Terminal.Out << "All FFI / Native ABI tests passed successfully!\n";
