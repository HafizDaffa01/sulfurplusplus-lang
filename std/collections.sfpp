// std/collections.sfpp
export this as std/collections;

// Collection utilities — all backed by native builtins

// List utilities
let map         = __builtins__.col_map;         // map(list, fn) -> list
let filter      = __builtins__.col_filter;      // filter(list, fn) -> list
let reduce      = __builtins__.col_reduce;      // reduce(list, fn, init) -> value
let any         = __builtins__.col_any;         // any(list, fn) -> bool
let all         = __builtins__.col_all;         // all(list, fn) -> bool
let find        = __builtins__.col_find;        // find(list, fn) -> value | null
let findIndex   = __builtins__.col_findindex;   // findIndex(list, fn) -> int (-1 if not found)
let flatten     = __builtins__.col_flatten;     // flatten(list) -> list
let unique      = __builtins__.col_unique;      // unique(list) -> list
let sort        = __builtins__.col_sort;        // sort(list, fn?) -> list
let sortBy      = __builtins__.col_sortby;      // sortBy(list, key_fn) -> list
let groupBy     = __builtins__.col_groupby;     // groupBy(list, key_fn) -> dict
let zip         = __builtins__.col_zip;         // zip(list, list) -> list<list>
let take        = __builtins__.col_take;        // take(list, n) -> list
let drop        = __builtins__.col_drop;        // drop(list, n) -> list
let count       = __builtins__.col_count;       // count(list, fn?) -> int
let sum         = __builtins__.col_sum;         // sum(list) -> int|float
let min         = __builtins__.col_min;         // min(list) -> value
let max         = __builtins__.col_max;         // max(list) -> value

// Dict utilities
let keys        = __builtins__.col_keys;        // keys(dict) -> list
let values      = __builtins__.col_values;      // values(dict) -> list
let entries     = __builtins__.col_entries;     // entries(dict) -> list<[k,v]>
let merge       = __builtins__.col_merge;       // merge(dict, dict) -> dict
let hasKey      = __builtins__.col_haskey;      // hasKey(dict, key) -> bool
