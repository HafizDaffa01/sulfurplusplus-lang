export this as std/math;

expose "PI" as PI;
expose "E" as E;
expose "TAU" as TAU;
expose "PHI" as PHI;
expose "INF" as INF;
expose "NEG_INF" as NEG_INF;
expose "NAN" as NAN;

expose "abs" as abs;
expose "sqrt" as sqrt;
expose "pow" as pow;
expose "floor" as floor;
expose "ceil" as ceil;
expose "round" as round;
expose "max" as max;
expose "min" as min;
expose "sin" as sin;
expose "cos" as cos;
expose "tan" as tan;
expose "log" as log;
expose "log2" as log2;
expose "log10" as log10;
